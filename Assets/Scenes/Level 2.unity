  m_EditorClassIdentifier: 
  dialogueMark: {fileID: 1721416111}
  dialogueLines:
  - "Hey, forastero. Bonito apocalipsis, \xBFno? Le da un toque\u2026 ca\xF3tico
    al vecindario."
  - "Menos mal me abastec\xED de cigarrillos. Sin ellos ya me habr\xEDa vuelto zombi,
    pero de estr\xE9s."
  - "Ah, s\xED, tambi\xE9n vendo otras cositas. \xC9chales un ojo\u2026 o los dos,
    si a\xFAn los tienes."
  dialoguePanel: {fileID: 795277508}
  dialogueText: {fileID: 331269380}
